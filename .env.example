# Samaritan Web UI — environment config
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must never be committed.

# Pinggy tunnel token — get from https://pinggy.io (Pro account for persistent URLs).
# Used by start-pinggy.sh to expose port 8801 over HTTPS.
PINGGY_TOKEN=

# Token required from the browser to access this app.
# Set this to any strong secret string. The browser will prompt for it once.
SAMARITAN_API_KEY=change-me-to-a-strong-secret

# Token forwarded to llmem-gw (must match API_KEY in llmem-gw's .env).
# Leave blank if llmem-gw has no API_KEY set.
LLMEM_GW_API_KEY=

# llmem-gw base URL (default: local)
LLMEM_GW_URL=http://localhost:8767

# xAI API key — used server-side only to proxy TTS requests
# (POST /api/tts/xai → https://api.x.ai/v1/tts). Never sent to browser.
# Required for FULL VOICE mode with the 'xai' provider.
# Get one at https://console.x.ai/
XAI_API_KEY=

# Inworld API key — Base64-encoded credential from Inworld Portal (Settings > API Keys).
# Used server-side only to proxy TTS requests (POST /api/tts/inworld). Never sent to browser.
# Required for FULL VOICE mode with the 'inworld' provider.
INWORLD_API_KEY=

# Deepgram API key — used server-side only to serve a token to the browser (GET /api/stt-token).
# The browser opens a WebSocket directly to Deepgram for real-time STT.
# Required for STT with the 'deepgram' provider (higher quality + barge-in support).
# Get one at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Google Drive photos subfolder ID — where manual snaps + auto-captures upload.
# Injected into index.html server-side (%%DRIVE_PHOTOS_FOLDER%%) so it stays out
# of the public tree. Must match the SMS photos folder used by llmem-gw.
DRIVE_PHOTOS_FOLDER_ID=

# MySQL credentials — required for /api/knowledge-graph, cost-event logging,
# and other direct aiomysql queries against the mymcp database. Without these,
# endpoints that hit MySQL will fail with "Access denied (using password: NO)".
MYSQL_USER=
MYSQL_PASS=
